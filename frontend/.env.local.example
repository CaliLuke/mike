NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# OpenTelemetry: ON by default in dev. Spans (browser fetch + manual nav
# spans) are batched and shipped to the backend at /v1/traces, persisted
# to <LUKE_DATA_DIR>/telemetry.sqlite. Set to "false" to disable.
NEXT_PUBLIC_OTEL_ENABLED=true

# Optional override (defaults to http://localhost:3001/v1/traces).
# NEXT_PUBLIC_OTEL_TRACES_URL=http://localhost:3001/v1/traces
