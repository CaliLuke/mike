{
  "threshold": 2,
  "reporters": ["console"],
  "ignore": [
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.d.ts",
    "**/generated/**",
    "**/node_modules/**",
    "**/.next/**",
    "**/.open-next/**",
    "**/out/**",
    "**/build/**",
    "**/coverage/**",
    "**/public/**"
  ],
  "gitignore": true,
  "minLines": 10,
  "minTokens": 50,
  "absolute": false,
  "format": ["typescript", "tsx", "javascript", "jsx"]
}
