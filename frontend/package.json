{
  "name": "luke",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "engines": {
    "node": ">=25.9.0 <27"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --disable-warning=DEP0205\" next dev",
    "build": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --disable-warning=DEP0205\" next build",
    "start": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --disable-warning=DEP0205\" next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix --max-warnings=0",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "knip": "knip",
    "duplication": "jscpd --config jscpd.json src",
    "check": "./check.sh",
    "check:fix": "./check.sh --fix",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.8",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-zone": "^2.7.1",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/instrumentation": "^0.217.0",
    "@opentelemetry/instrumentation-fetch": "^0.217.0",
    "@opentelemetry/sdk-trace-web": "^2.7.1",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-form": "^1.32.0",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/pm": "^3.23.1",
    "@tiptap/react": "^3.23.1",
    "@tiptap/starter-kit": "^3.23.1",
    "@types/jsdom": "^28.0.1",
    "@uiw/react-md-editor": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.6.1",
    "docx-preview": "^0.3.7",
    "exceljs": "^4.4.0",
    "katex": "^0.16.45",
    "lucide-react": "^1.14.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.3",
    "next": "16.2.6",
    "nextjs-toploader": "^3.9.17",
    "pdfjs-dist": "5.7.284",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-gfm-configurable": "^1.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.5.0",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query-devtools": "^5.100.10",
    "@types/node": "^25.6.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.10.29",
    "eslint": "^10.3.0",
    "eslint-config-next": "^16.2.6",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jscpd": "^4.1.0",
    "knip": "^6.12.2",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "wrangler": "^4.90.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.10",
    "postcss": "^8.5.14"
  }
}
