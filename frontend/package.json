    "@types/uuid": "^10.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.9.11",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
