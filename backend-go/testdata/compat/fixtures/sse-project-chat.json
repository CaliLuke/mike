{
  "name": "sse-project-chat",
  "transport": "sse",
  "request": {
    "method": "POST",
    "path": "/projects/{projectId}/chat",
    "body": {
      "messages": [
        {
          "role": "user",
          "content": "Fixture project hello"
        }
      ],
      "model": "gemma4"
    }
  },
  "response": {
    "status": 200,
    "contentTypeIncludes": "text/event-stream",
    "allowedEventNames": [
      "message"
    ],
    "requiredPayloadTypes": [
      "chat_id",
      "content_delta",
      "citations",
      "done"
    ],
    "payloadSchemas": {
      "chat_id": {
        "type": "string"
      },
      "content_delta": {
        "type": "string",
        "text": "string"
      },
      "citations": {
        "type": "string",
        "citations": "array"
      }
    }
  },
  "notes": "Parameterized by projectId because project creation depends on authenticated Supabase state."
}
