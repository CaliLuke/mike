    {
      "id": "career_context.find_in_document",
      "service": "chat",
      "toolset": "chat.career_context",
      "title": "Find In Document",
      "description": "Find exact text matches in one local document",
      "payload": {
        "name": "FindInDocumentPayload",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "context_chars": {
              "type": "integer",
              "description": "Characters of context to include around each match",
              "example": 1105822757182556325,
              "format": "int64"
            },
            "document_id": {
              "type": "string",
              "description": "Local document identifier to search",
              "example": "Dolores esse doloribus sed."
            },
            "max_results": {
              "type": "integer",
              "description": "Maximum number of matches to return",
              "example": 1895818119039641250,
              "format": "int64"
            },
            "query": {
              "type": "string",
              "description": "Exact text to find",
              "example": "Fugit mollitia."
            }
          }
        }
      },
      "result": {
        "name": "FindInDocumentResult",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "document_id": {
              "type": "string",
              "description": "Local document identifier",
              "example": "Omnis aut neque natus."
            },
            "filename": {
              "type": "string",
              "description": "Document filename",
              "example": "Veritatis perspiciatis et sit."
            },
            "matches": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AssistantDocumentMatch"
              },
              "description": "Search matches",
              "example": [
                {
                  "context": "Saepe alias molestiae non quod.",
                  "end": 5719748636997510407,
                  "index": 2065028034511971755,
                  "quote": "Ut ut inventore consequatur sunt.",
                  "start": 1395715438801014062
                },
                {
                  "context": "Saepe alias molestiae non quod.",
                  "end": 5719748636997510407,
                  "index": 2065028034511971755,
                  "quote": "Ut ut inventore consequatur sunt.",
                  "start": 1395715438801014062
                }
              ]
            },
            "total_matches": {
              "type": "integer",
              "description": "Total matches found before truncation",
              "example": 5262142507620182810,
              "format": "int64"
            }
          },
          "$defs": {
            "AssistantDocumentMatch": {
              "title": "AssistantDocumentMatch",
              "type": "object",
              "properties": {
                "context": {
                  "type": "string",
                  "description": "Surrounding text context",
                  "example": "Atque et."
                },
                "end": {
                  "type": "integer",
                  "description": "End character offset",
                  "example": 1854651302258767577,
                  "format": "int64"
                },
                "index": {
                  "type": "integer",
                  "description": "Zero-based match index",
                  "example": 3334537504489939987,
                  "format": "int64"
                },
                "quote": {
                  "type": "string",
                  "description": "Matched text",
                  "example": "Laudantium ipsam."
                },
                "start": {
                  "type": "integer",
                  "description": "Start character offset",
                  "example": 4535960170544007177,
                  "format": "int64"
                }
              },
              "example": {
                "context": "Ut voluptatem.",
                "end": 2528730940923538831,
                "index": 304751684415316778,
                "quote": "Laboriosam adipisci totam corrupti optio non.",
                "start": 4868060005518389493
              }
            }
          }
        }
      }
    },
