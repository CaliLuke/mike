    {
      "id": "career_context.fetch_documents",
      "service": "chat",
      "toolset": "chat.career_context",
      "title": "Fetch Documents",
      "description": "Fetch text from multiple local documents",
      "payload": {
        "name": "FetchDocumentsPayload",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "document_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "example": "Modi culpa deserunt et accusantium dolores voluptatem."
              },
              "description": "Local document identifiers to fetch",
              "example": [
                "Aperiam similique ab placeat incidunt earum.",
                "Est sed.",
                "Et voluptatem autem."
              ]
            }
          }
        }
      },
      "result": {
        "name": "FetchDocumentsResult",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "documents": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AssistantDocumentText"
              },
              "description": "Fetched document contents",
              "example": [
                {
                  "document_id": "Asperiores est quo voluptatum non.",
                  "filename": "Molestiae voluptas modi molestiae tempore.",
                  "text": "Sed quos cupiditate iure qui sint."
