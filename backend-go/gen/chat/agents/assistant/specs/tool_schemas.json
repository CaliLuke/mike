    {
      "id": "career_context.edit_document",
      "service": "chat",
      "toolset": "chat.career_context",
      "title": "Edit Document",
      "description": "Apply text replacements to an editable DOCX document as a new version",
      "payload": {
        "name": "EditDocumentPayload",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "document_id": {
              "type": "string",
              "description": "Local document identifier to edit",
              "example": "Laboriosam ut omnis dolorum voluptas facere odit."
            },
            "edits": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AssistantDocumentEdit"
              },
              "description": "Text replacement edits",
              "example": [
                {
                  "context_after": "Excepturi dolorem et ad.",
                  "context_before": "Ipsam in.",
                  "find": "Ea ut ut asperiores aspernatur.",
                  "reason": "Corrupti dignissimos et.",
                  "replace": "Rerum atque ut rem qui."
                },
                {
                  "context_after": "Excepturi dolorem et ad.",
                  "context_before": "Ipsam in.",
                  "find": "Ea ut ut asperiores aspernatur.",
                  "reason": "Corrupti dignissimos et.",
                  "replace": "Rerum atque ut rem qui."
                }
              ]
            }
          },
          "$defs": {
            "AssistantDocumentEdit": {
              "title": "AssistantDocumentEdit",
              "type": "object",
              "properties": {
                "context_after": {
                  "type": "string",
                  "description": "Optional expected text after the match",
                  "example": "Amet ut ut."
                },
                "context_before": {
                  "type": "string",
                  "description": "Optional expected text before the match",
                  "example": "Sapiente ratione suscipit sint harum."
                },
                "find": {
                  "type": "string",
                  "description": "Exact text to replace",
                  "example": "Sint sunt ullam non quia."
                },
                "reason": {
                  "type": "string",
                  "description": "Reason for the change",
                  "example": "Aut tenetur cumque inventore ratione non voluptatem."
                },
                "replace": {
                  "type": "string",
                  "description": "Replacement text",
                  "example": "Est non laudantium."
                }
              },
              "example": {
                "context_after": "Non totam id ut quasi hic et.",
                "context_before": "Deleniti aut hic sint earum earum.",
                "find": "Consequatur quia reprehenderit consectetur quasi.",
                "reason": "Voluptas numquam quasi perferendis earum debitis.",
                "replace": "Voluptatem expedita praesentium tempora distinctio necessitatibus."
              }
            }
          }
        }
      },
      "result": {
        "name": "EditDocumentResult",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
